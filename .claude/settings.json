{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git show:*)"
    ]
  },
  "enabledPlugins": {
    "claude-utils@dev-tools": true
  },
  "extraKnownMarketplaces": {
    "dev-tools": {
      "source": {
        "source": "github",
        "repo": "vynarim/ClaudePlugins"
      }
    }
  }
}
